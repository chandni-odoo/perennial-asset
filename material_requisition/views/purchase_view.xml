<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit the Purchase Order Form -->
    <record id="view_purchase_order_form_inherit_requisition" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.requsition</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="partner_ref" position="before">
                <field name="requisition_id" readonly="1" invisible="1"/>
            </field>
            <xpath expr="//list/field[@name='product_id']" position="before">
                <field name="mr_line_id" optional="hide" />
            </xpath>
        </field>
    </record>
</odoo>
<odoo>

    <!-- Tree and Form for Controller Type -->
    <record id="view_asset_controller_tree" model="ir.ui.view">
        <field name="name">asset.controller.tree</field>
        <field name="model">asset.controller</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_asset_controller_form" model="ir.ui.view">
        <field name="name">asset.controller.form</field>
        <field name="model">asset.controller</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_controller" model="ir.actions.act_window">
        <field name="name">Controller Type</field>
        <field name="res_model">asset.controller</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

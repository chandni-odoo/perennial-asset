<odoo>
    <!-- Category Type -->
    <record id="view_asset_category_list_model" model="ir.ui.view">
        <field name="name">asset.category.list</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <list string="Category">
                <field name="name" />
            </list>
        </field>
    </record>
    <record id="view_asset_category_form" model="ir.ui.view">
        <field name="name">asset.category.form</field>
        <field name="model">asset.category</field>
        <field name="arch" type="xml">
            <form string="Category">
                <sheet>
                    <group>
                        <field name="name" />
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_asset_category" model="ir.actions.act_window">
        <field name="name">Category Type</field>
        <field name="res_model">asset.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
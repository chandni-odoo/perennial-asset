<odoo>
    <!-- Form View -->
    <record id="view_rating_master_form" model="ir.ui.view">
        <field name="name">rating.master.form</field>
        <field name="model">rating.master</field>
        <field name="arch" type="xml">
            <form string="Rating KVA Master">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_rating_master_list" model="ir.ui.view">
        <field name="name">rating.master.list</field>
        <field name="model">rating.master</field>
        <field name="arch" type="xml">
            <list string="Rating KVA Master">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_rating_master" model="ir.actions.act_window">
        <field name="name">Rating KVA</field>
        <field name="res_model">rating.master</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
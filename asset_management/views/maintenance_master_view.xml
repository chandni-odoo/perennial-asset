<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- list View -->
    <record id="view_list_maintenance_master" model="ir.ui.view">
        <field name="name">maintenance.master.list</field>
        <field name="model">maintenance.master</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="asset_type_id"/>
                <field name="frequency"/>
                <field name="usage_meter_reading"/>
                <field name="usage_uom"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_form_maintenance_master" model="ir.ui.view">
        <field name="name">maintenance.master.form</field>
        <field name="model">maintenance.master</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="asset_type_id"/>
                        <field name="frequency"/>
                        <field name="usage_meter_reading"/>
                        <field name="usage_uom"/>
                        <field name="checklist"/>
                    </group>

                    <notebook>
                        <page string="Maintenance Checklist">
                            <field name="checklist_line_ids">
                                <list editable="bottom">
                                    <field name="section"/>
                                    <field name="type"/>
                                    <field name="product_id"/>
                                    <field name="activity"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- Action -->
    <record id="action_maintenance_master" model="ir.actions.act_window">
        <field name="name">Maintenance Master</field>
        <field name="res_model">maintenance.master</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>

<odoo>
    <!-- Business Unit Form and List Views -->
    <record id="view_business_unit_form" model="ir.ui.view">
        <field name="name">business.unit.form</field>
        <field name="model">business.unit</field>
        <field name="arch" type="xml">
            <form string="Business Unit">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_business_unit_list" model="ir.ui.view">
        <field name="name">business.unit.list</field>
        <field name="model">business.unit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_business_unit" model="ir.actions.act_window">
        <field name="name">Business Units</field>
        <field name="res_model">business.unit</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
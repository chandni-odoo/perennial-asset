<odoo>
    <!-- Form View -->
    <record id="view_phase_master_form" model="ir.ui.view">
        <field name="name">phase.master.form</field>
        <field name="model">phase.master</field>
        <field name="arch" type="xml">
            <form string="Phase Master">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_phase_master_list" model="ir.ui.view">
        <field name="name">phase.master.list</field>
        <field name="model">phase.master</field>
        <field name="arch" type="xml">
            <list string="Phase Master">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_phase_master" model="ir.actions.act_window">
        <field name="name">Phase Master</field>
        <field name="res_model">phase.master</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

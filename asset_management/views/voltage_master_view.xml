<odoo>
    <!-- Form View -->
    <record id="view_voltage_master_form" model="ir.ui.view">
        <field name="name">voltage.master.form</field>
        <field name="model">voltage.master</field>
        <field name="arch" type="xml">
            <form string="Voltage Master">
                <sheet>
                    <field name="name"/>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List View -->
    <record id="view_voltage_master_list" model="ir.ui.view">
        <field name="name">voltage.master.list</field>
        <field name="model">voltage.master</field>
        <field name="arch" type="xml">
            <list string="Voltage Master">
                <field name="name"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_voltage_master" model="ir.actions.act_window">
        <field name="name">Voltage Master</field>
        <field name="res_model">voltage.master</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>

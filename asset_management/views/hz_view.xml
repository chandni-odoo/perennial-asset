<odoo>
    <!-- Tree and Form for HZ -->
    <record id="view_asset_hz_tree" model="ir.ui.view">
        <field name="name">asset.hz.tree</field>
        <field name="model">asset.hz</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="view_asset_hz_form" model="ir.ui.view">
        <field name="name">asset.hz.form</field>
        <field name="model">asset.hz</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_asset_hz" model="ir.actions.act_window">
        <field name="name">HZ</field>
        <field name="res_model">asset.hz</field>
        <field name="view_mode">list,form</field>
    </record>

 
</odoo>

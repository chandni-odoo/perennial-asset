<odoo>
    <data noupdate="1">
        <record id="seq_purchase_rental_order" model="ir.sequence">
            <field name="name">Rental Order</field>
            <field name="code">purchase.rental.order</field>
            <field name="prefix">RENTAL/</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
        </record>
        <record id="rental_every_1_days" model="rental.intervals">
            <field name="name">Daily</field>
            <field name="recurring_interval">1</field>
            <field name="recurring_rule_type">daily</field>
        </record>
        <record id="rental_every_2_days" model="rental.intervals">
            <field name="name">Every Two Days</field>
            <field name="recurring_interval">2</field>
            <field name="recurring_rule_type">daily</field>
        </record>
        <record id="rental_every_3_days" model="rental.intervals">
            <field name="name">Every Three Days</field>
            <field name="recurring_interval">3</field>
            <field name="recurring_rule_type">daily</field>
        </record>
        <record id="rental_every_1_weeks" model="rental.intervals">
            <field name="name">Weekly</field>
            <field name="recurring_interval">1</field>
            <field name="recurring_rule_type">weekly</field>
        </record>
        <record id="rental_every_2_weeks" model="rental.intervals">
            <field name="name">Bi-weekly</field>
            <field name="recurring_interval">2</field>
            <field name="recurring_rule_type">weekly</field>
        </record>
        <record id="rental_every_3_weeks" model="rental.intervals">
            <field name="name">Tri-weekly</field>
            <field name="recurring_interval">3</field>
            <field name="recurring_rule_type">weekly</field>
        </record>
        <record id="rental_every_1_months" model="rental.intervals">
            <field name="name">Monthly</field>
            <field name="recurring_interval">1</field>
            <field name="recurring_rule_type">monthly</field>
        </record>
        <record id="rental_every_2_months" model="rental.intervals">
            <field name="name">Bi-monthly</field>
            <field name="recurring_interval">2</field>
            <field name="recurring_rule_type">monthly</field>
        </record>
        <record id="rental_every_3_months" model="rental.intervals">
            <field name="name">Quarterly</field>
            <field name="recurring_interval">3</field>
            <field name="recurring_rule_type">monthly</field>
        </record>
        <record id="rental_every_1_years" model="rental.intervals">
            <field name="name">Yearly</field>
            <field name="recurring_interval">1</field>
            <field name="recurring_rule_type">yearly</field>
        </record>
        <record id="rental_every_2_years" model="rental.intervals">
            <field name="name">Bi-Yearly</field>
            <field name="recurring_interval">2</field>
            <field name="recurring_rule_type">yearly</field>
        </record>
        <record id="rental_every_3_years" model="rental.intervals">
            <field name="name">Tri-Yearly</field>
            <field name="recurring_interval">3</field>
            <field name="recurring_rule_type">yearly</field>
        </record>

    </data>
</odoo>
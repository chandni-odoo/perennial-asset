<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_partner_form_inh_rental" model="ir.ui.view">
        <field name="name">res.partner.form.inh.rental</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field type="xml" name="arch">
            <xpath expr="//div[@name='button_box']" position="inside">
                <!-- New Rental Orders Button -->
                <button name="action_open_purchase_rental_orders" type="object"
                        class="oe_stat_button" icon="fa-pencil-square-o">
                    <field name="purchase_rental_order_count" widget="statinfo" string="Rental Orders"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
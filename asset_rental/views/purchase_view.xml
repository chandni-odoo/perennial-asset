<odoo>
    <!-- Inherit the Purchase Order Form -->
    <record id="view_purchase_order_form_inherit_rerental" model="ir.ui.view">
        <field name="name">purchase.order.form.inherit.rerental</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form" />
        <field name="arch" type="xml">
            <field name="partner_ref" position="before">
                <field name="re_rental_order_id" readonly="1" />
            </field>
            <xpath expr="//list/field[@name='product_id']" position="before">
                <field name="is_rerental" string="Rental" />
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="payment_date" />
            </field>
        </field>
    </record>
</odoo>
<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="rental_intervals_list_view" model="ir.ui.view">
        <field name="name">rental.intervals.list</field>
        <field name="model">rental.intervals</field>
        <field name="arch" type="xml">
            <list editable="top">
                <field name="name" />
                <field name="recurring_interval" class="oe_inline" />
                <field name="recurring_rule_type" />
            </list>
        </field>
    </record>
    <record id="action_rental_intervals" model="ir.actions.act_window">
        <field name="name">Rental Intervals</field>
        <field name="res_model">rental.intervals</field>
        <field name="view_mode">list</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Rental intervals.
            </p>
        </field>
    </record>  
</odoo>
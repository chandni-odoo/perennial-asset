<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_form_inherit_rental" model="ir.ui.view">
        <field name="name">product.template.form.rental.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='options']" position='inside'>
                <span class="d-inline-flex">
                    <field name="rerent_ok"/>
                    <label for="rerent_ok"/>
                </span>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Rental Information" name="rental_information" invisible="not rerent_ok">
                    <group name="recurrence_info">
                        <group>
                            <field name="rental_intervals" widget="many2many_tags" required="rerent_ok" />
                        </group>
                        <group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>